{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tests"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
