{
  "expo": {
    "name": "Comic Reader",
    "slug": "comic-reader",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "comicreader",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "br.fmatheusog.comicreader",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3B6EF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1B1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-asset",
      "react-native-blob-util"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5de5186d-fe0a-4593-9d80-034763bc6de8"
      }
    }
  }
}
